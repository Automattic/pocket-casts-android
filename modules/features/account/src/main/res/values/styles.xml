<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="error_text">
        <item name="android:textColor">#D32F2F</item>
    </style>

    <style name="PCTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_stroke_color</item>
        <item name="passwordToggleTint">?attr/primary_icon_03</item>
        <item name="hintTextColor">?attr/primary_interactive_01</item>
        <item name="android:textColorHint">?attr/primary_text_02</item>
    </style>

    <style name="PCPasswordTextInputLayout" parent="PCTextInputLayout">
        <item name="passwordToggleEnabled">true</item>
    </style>

    <style name="PCCarTextInputLayout" parent="PCTextInputLayout">
        <item name="hintTextAppearance">@style/TextAppearanceCarHint</item>
    </style>

    <style name="PCCarPasswordTextInputLayout" parent="PCPasswordTextInputLayout">
        <item name="hintTextAppearance">@style/TextAppearanceCarHint</item>
    </style>

    <style name="ThemeOverlay.PocketCasts.TextInput" parent="">
        <item name="textInputStyle">@style/PCTextInputLayout</item>
    </style>

    <style name="ThemeOverlay.PocketCasts.PasswordTextInput" parent="">
        <item name="textInputStyle">@style/PCPasswordTextInputLayout</item>
    </style>

    <style name="ThemeOverlay.PocketCasts.CarTextInput" parent="">
        <item name="textInputStyle">@style/PCCarTextInputLayout</item>
    </style>

    <style name="ThemeOverlay.PocketCasts.CarPasswordTextInput" parent="">
        <item name="textInputStyle">@style/PCCarPasswordTextInputLayout</item>
    </style>
</resources>