#!/bin/sh

# This file is `source`'d before calling `buildkite-agent pipeline upload`, and can be used
# to set up some variables that will be interpolated in the `.yml` pipeline before uploading it.

export CI_TOOLKIT="automattic/a8c-ci-toolkit#8.0.1"

# Skip decisions, made here on the upload agent so that skipped jobs never wait for an agent.
# One variable per job type: `false` runs the step, anything else is the reason to skip it. The pipeline uses them as `skip: "$SKIP_…"`.
# This file is also sourced with `sh` (release-toolkit's `buildkite_pipeline_upload`), so keep it POSIX. Any error runs the job.
for job_type in validation lint unit-tests instrumented-tests app-build automotive-build wear-build tv-build; do
  skip_var="SKIP_$(echo "$job_type" | tr 'a-z-' 'A-Z_')"
  skip_reason=$(.buildkite/commands/should-skip-job.sh --job-type "$job_type") || skip_reason=false
  export "$skip_var=$skip_reason"
  echo "$skip_var=$skip_reason"
done
